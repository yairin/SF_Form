    <type>Picklist</type>
    <required>false</required>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Anonymous</fullName>
                <default>true</default>
                <label>אנונימי</label>
            </value>
            <value>
                <fullName>Identified</fullName>
                <default>false</default>
                <label>מזוהה (הזדהות ממשלתית)</label>
            </value>
            <value>
                <fullName>Applicant_Choice</fullName>
                <default>false</default>
                <label>לבחירת הממלא</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
