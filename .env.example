# Salesforce Sandbox credentials
# Create a Connected App in your Salesforce Sandbox:
# Setup > App Manager > New Connected App
# Enable OAuth, add callback URL, and select scopes (api, refresh_token)

SF_LOGIN_URL=https://test.salesforce.com
SF_USERNAME=your_sandbox_username@example.com.sandbox_name
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token

# Optional: Connected App credentials (for OAuth2 client_credentials flow)
# SF_CLIENT_ID=your_consumer_key
# SF_CLIENT_SECRET=your_consumer_secret

# Server config
PORT=3000
NODE_ENV=development

# ── Emergency event object (מאגר חירום) — used by /emergency form ──────────
# Object + field API names. Defaults are PLACEHOLDERS — set these to the real
# API names from the "מאגר חירום" module (retrieve with scripts/sf-retrieve.sh).
SF_EMERGENCY_OBJECT=Emergency_Event__c
SF_EMERGENCY_DEFAULT_STATUS=פתוח
SF_F_TITLE=Name
SF_F_TYPE=Event_Type__c
SF_F_SEVERITY=Severity__c
SF_F_LOCATION=Location__c
SF_F_DESCRIPTION=Description__c
SF_F_REPORTER=Reporter_Name__c
SF_F_PHONE=Contact_Phone__c
SF_F_CASUALTIES=Casualties_Count__c
SF_F_OCCURRED_AT=Occurred_At__c
