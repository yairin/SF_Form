# Salesforce Sandbox credentials
# Create a Connected App in your Salesforce Sandbox:
# Setup > App Manager > New Connected App
# Enable OAuth, add callback URL, and select scopes (api, refresh_token)

SF_LOGIN_URL=https://test.salesforce.com
SF_USERNAME=your_sandbox_username@example.com.sandbox_name
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token

# Optional: Connected App credentials (for OAuth2 client_credentials flow)
# SF_CLIENT_ID=your_consumer_key
# SF_CLIENT_SECRET=your_consumer_secret

# Server config
PORT=3000
NODE_ENV=development
