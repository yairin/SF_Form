# ==== בית אחד — הגדרות סביבה ====

# מפתח לחתימת טוקנים (JWT). חובה לשנות בפרודקשן למחרוזת אקראית וארוכה.
JWT_SECRET=change-me-to-a-long-random-secret

# קוד ההצטרפות ליצירת בן המשפחה הראשון (הורה מנהל). אופציונלי — הגנה בסיסית.
SETUP_CODE=

# פורט השרת (Cloud Run מזריק PORT אוטומטית).
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------
# אחסון — עדיפות: Firestore → Postgres → קובץ JSON מקומי
# ---------------------------------------------------------------

# --- Firebase / Firestore (מומלץ) ---
# הגדרת FIREBASE_PROJECT_ID (או USE_FIRESTORE=true) מפעילה אחסון ב-Firestore.
# ב-Cloud Run / Cloud Functions ההרשאות נטענות אוטומטית — די ב-FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# USE_FIRESTORE=true
# מקומית מחוץ ל-Google Cloud: או GOOGLE_APPLICATION_CREDENTIALS לקובץ service account,
# או FIREBASE_SERVICE_ACCOUNT עם תוכן ה-JSON של המפתח (שורה אחת).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# --- חלופה: Postgres (אם לא משתמשים ב-Firestore) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PGSSL=true

# ---------------------------------------------------------------
# התראות WhatsApp (WhatsApp Cloud API של Meta)
# אם ריק — ההתראות רק נרשמות ל-console (מצב dry-run), והמערכת פועלת כרגיל.
# ---------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# WHATSAPP_API_VERSION=v20.0
