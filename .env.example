# ==== בית אחד — הגדרות סביבה ====

# מפתח לחתימת טוקנים (JWT). חובה לשנות בפרודקשן למחרוזת אקראית וארוכה.
JWT_SECRET=change-me-to-a-long-random-secret

# מסד נתונים בענן (Postgres). אם מוגדר — הנתונים נשמרים ב-Postgres.
# אם ריק — הנתונים נשמרים בקובץ מקומי data/db.json (טוב לפיתוח/הרצה מהירה).
# דוגמה (Railway/Supabase/Render):
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# האם להשתמש ב-SSL בחיבור ל-Postgres (רוב ספקי הענן דורשים). ברירת מחדל: true כשיש DATABASE_URL.
PGSSL=true

# קוד ההצטרפות ליצירת בן המשפחה הראשון (הורה מנהל). אופציונלי — הגנה בסיסית.
# אם מוגדר, נדרש כדי ליצור את ההורה הראשון בעת אתחול הבית.
SETUP_CODE=

# פורט השרת
PORT=3000
NODE_ENV=development
