# Salesforce Sandbox credentials
# Create a Connected App in your Salesforce Sandbox:
# Setup > App Manager > New Connected App
# Enable OAuth, add callback URL, and select scopes (api, refresh_token)

# My Domain login URL for the MUNIFORCE sandbox (derived from the Lightning
# URL https://localgovernmenteconomicserviceslt2--mashamdev.sandbox.lightning.force.com
# by swapping .lightning.force.com for .my.salesforce.com). Confirmed to exist,
# but not yet reachable/tested from this dev environment — see
# API_IMPLEMENTATION_NOTES.md "חיבור לרשת" for why.
SF_LOGIN_URL=https://localgovernmenteconomicserviceslt2--mashamdev.sandbox.my.salesforce.com
SF_USERNAME=your_sandbox_username@example.com.mashamdev
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token

# Optional: Connected App credentials (for OAuth2 client_credentials flow)
# SF_CLIENT_ID=your_consumer_key
# SF_CLIENT_SECRET=your_consumer_secret

# Server config
PORT=3000
NODE_ENV=development

# --- AI phone-system case-opening API (POST /api/cases) ---

# Person Account record type used when creating new Account (resident) records.
# Confirm the real Id with the org admin.
SF_PERSON_ACCOUNT_RECORD_TYPE_ID=

# OwnerId stamped on newly created ContactPointPhone records.
SF_CONTACT_POINT_OWNER_ID=

# Case lookup field API names — the source spec gives some of these as SOQL
# relationship paths rather than real field names; confirm with the org admin
# before relying on the defaults in src/config.js.
SF_CASE_FIELD_CATEGORY=
SF_CASE_FIELD_TOPIC=
SF_CASE_FIELD_SUBTOPIC=
SF_CASE_FIELD_CASE_ROUTE=
SF_CASE_FIELD_LOCATION=
SF_CASE_FIELD_ADDRESS=

# OAuth2 client_credentials issued by this API to the AI phone system (POST /oauth/token)
AI_CLIENT_ID=
AI_CLIENT_SECRET=
JWT_SECRET=
AI_TOKEN_TTL_SECONDS=3600
