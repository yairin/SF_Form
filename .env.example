# Salesforce Sandbox credentials
# Create a Connected App in your Salesforce Sandbox:
# Setup > App Manager > New Connected App
# Enable OAuth, add callback URL, and select scopes (api, refresh_token)

# My Domain login URL for the MUNIFORCE sandbox (derived from the Lightning
# URL https://localgovernmenteconomicserviceslt2--mashamdev.sandbox.lightning.force.com
# by swapping .lightning.force.com for .my.salesforce.com). CONFIRMED WORKING —
# npm run discover-sf-schema connected successfully with this URL.
SF_LOGIN_URL=https://localgovernmenteconomicserviceslt2--mashamdev.sandbox.my.salesforce.com
SF_USERNAME=your_sandbox_username@example.com.mashamdev
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token

# Connected App consumer key/secret — LEAVE THESE BLANK. Confirmed in this org's
# Login History that the OAuth2 username-password flow is disabled org-wide
# ("זרימת שם משתמש-סיסמה מושבתת"), so this path will always fail with
# invalid_grant no matter what's configured here. The legacy SOAP login() path
# (leave both blank) works once the user has the "Use Any API Client" /
# "השתמש באימות API כלשהו" system permission — confirmed working.
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Server config
PORT=3000
NODE_ENV=development

# --- AI phone-system case-opening API (POST /api/cases) ---
# Field names/Ids below are CONFIRMED against the real sandbox via
# `npm run discover-sf-schema` — see API_IMPLEMENTATION_NOTES.md for the full dump.

# Person Account record type ("חשבון אישי") — confirmed, also this org's default
# Account record type.
SF_PERSON_ACCOUNT_RECORD_TYPE_ID=012Wn0000004InxIAE

# Optional override for Case.OwnerId (reference -> Group, User; required=true
# per describe(), but the API doesn't determine ownership — that's the org's
# own assignment/routing automation's job, which can populate it via a
# before-insert Flow before Salesforce's required-field check runs). Leave
# blank to let that automation handle it; only set this if case creation
# actually fails with a REQUIRED_FIELD_MISSING error on OwnerId.
SF_CASE_DEFAULT_OWNER_ID=

# OwnerId stamped on newly created ContactPointPhone records. Moot for now — see
# note below, this object isn't usable in this org yet.
SF_CONTACT_POINT_OWNER_ID=

# Case field API names — confirmed. category/topic/subtopic are plain picklists,
# NOT lookups (the source spec's RegulatoryAuthorizationType__r__... names don't
# exist as real fields); their valid values are municipality-specific.
SF_CASE_FIELD_CATEGORY=Category__c
SF_CASE_FIELD_TOPIC=Topic__c
SF_CASE_FIELD_SUBTOPIC=Sub_Topic__c
SF_CASE_FIELD_CASE_ROUTE=CaseRoute__c
SF_CASE_FIELD_LOCATION=Location__c
SF_CASE_FIELD_ADDRESS=Address__c

# NOT YET RESOLVED: the ContactPointPhone object does not exist/isn't accessible
# in this org (discover-sf-schema returned NOT_FOUND describing it), despite the
# source spec describing phone numbers as living there. The code now skips this
# step without failing case creation (src/routes/cases.js), but where the phone
# number should actually be stored needs an answer from the org admin.

# OAuth2 client_credentials issued by this API to the AI phone system (POST /oauth/token)
AI_CLIENT_ID=
AI_CLIENT_SECRET=
JWT_SECRET=
AI_TOKEN_TTL_SECONDS=3600
