{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "src/**",
      "scripts/**",
      "server.js",
      "Dockerfile"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "bait-echad",
          "region": "me-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
