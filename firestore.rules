rules_version = '2';

// כל הגישה לנתונים עוברת דרך שרת ה-API (Admin SDK) שעוקף את הכללים האלה.
// הלקוח לעולם לא ניגש ישירות ל-Firestore, לכן נועלים גישה ישירה לחלוטין.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
